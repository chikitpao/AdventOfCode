# Usage: sage crt.sage

# m = 29, a = 0
# m = 41, a = 22
# m = 521, a = 492
# m = 23, a = 9
# m = 13, a = 10
# m = 17, a = 5
# m = 601, a = 541
# m = 37, a = 8
# m = 19, a = 16

v = [(0, 29), (22, 41), (492, 521), (9, 23), (10, 13), (5, 17), (541, 601), (8, 37), (16, 19)]

a = v[0][0]
m = v[0][1]
for i in range(1, len(v)):
    a = crt(a, v[i][0], m, v[i][1])
    m = m * v[i][1]
    print(a, m)

